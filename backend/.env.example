# Parallax Backend Configuration
PROJECT_NAME="Parallax API"
PROJECT_DESCRIPTION="AI-powered Teacher Intelligence Platform"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# Server
HOST="127.0.0.1"
PORT=8000

# Database (SQLite default for local development)
DATABASE_URL="sqlite:///./parallax.db"

# CORS (comma-separated list of origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Gemini API Configuration (Read exclusively by backend)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Session Security Secret
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production"

